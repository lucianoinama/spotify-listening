# Copy to .env and fill in. .env is git-ignored; never put real values in this file.

# Spotify app (https://developer.spotify.com/dashboard)
# The redirect URI must be registered in the app settings exactly as written here.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Last.fm, the source of genres (Spotify no longer returns them).
# Free key: https://www.last.fm/api/account/create
# Only artist names are sent. Leave empty to run without genres.
LASTFM_API_KEY=

# Postgres
POSTGRES_DB=spotify
POSTGRES_USER=spotify
POSTGRES_PASSWORD=change_me

# Streamlit app: password of the read-only database role it connects with (any long random string).
APP_DB_PASSWORD=

# Streamlit chat (https://console.anthropic.com). Leave empty to use the dashboard without chat.
# Questions and the query results that answer them are sent to Anthropic.
ANTHROPIC_API_KEY=
# Default is the cheapest model. If answers are wrong, try claude-sonnet-5-5 or claude-opus-5-5
# (about 20x and 40x the cost) and raise CHAT_EFFORT to medium.
# CHAT_MODEL=claude-haiku-5-5
# CHAT_EFFORT=low
# CHAT_MAX_QUESTIONS=25
# Show the SQL the chat ran, under each answer. Only for debugging the prompt.
# CHAT_SHOW_SQL=1

# Ingestion
INGEST_INTERVAL_MINUTES=15
ARTIST_REFRESH_DAYS=30

# Used by dbt to compute local day and hour
LOCAL_TIMEZONE=America/Argentina/Buenos_Aires
